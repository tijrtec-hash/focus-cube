<Window x:Class="FocusCube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCube.Controls"
        Title="Focus Cube"
        Width="360"
        Height="486"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#404548" Offset="0" />
            <GradientStop Color="#303538" Offset="0.48" />
            <GradientStop Color="#252A2D" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DrawerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3C4144" Offset="0" />
            <GradientStop Color="#2B3033" Offset="0.45" />
            <GradientStop Color="#23282B" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DisplayFrameBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#343A3D" Offset="0" />
            <GradientStop Color="#1D2225" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DisplayBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B1011" Offset="0" />
            <GradientStop Color="#050708" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="IncrementButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F6F6" />
            <Setter Property="Background" Value="#353B3E" />
            <Setter Property="BorderBrush" Value="#566064" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="5,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="7" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#92E7D9" />
                                <Setter TargetName="Chrome" Property="Background" Value="#3A4345" />
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.65" Color="#53E2CB" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Background" Value="#242A2C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#CDD5D6" />
            <Setter Property="Background" Value="#1E2325" />
            <Setter Property="BorderBrush" Value="#464F52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8C999D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Background" Value="#141819" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="342" />
            <RowDefinition Height="15" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <!-- Main body -->
        <Border Grid.Row="0"
                CornerRadius="28"
                Background="{StaticResource BodyBrush}"
                BorderBrush="#596166"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="11" Direction="270" Opacity="0.62" Color="#000000" />
            </Border.Effect>

            <Grid Margin="17">
                <Border CornerRadius="22"
                        Background="#222729"
                        BorderBrush="#6A7174"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="315" Opacity="0.4" Color="#000000" />
                    </Border.Effect>

                    <Grid Margin="7">
                        <Border CornerRadius="18"
                                Background="{StaticResource DisplayFrameBrush}"
                                BorderBrush="#171B1D"
                                BorderThickness="2">
                            <Grid Margin="5">
                                <Border CornerRadius="15"
                                        Background="{StaticResource DisplayBrush}"
                                        BorderBrush="#050607"
                                        BorderThickness="1" />

                                <Grid Margin="12,10,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="TIMER"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="15"
                                               Foreground="#E9EEEE"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Grid Grid.Row="1">
                                        <local:ProgressRing Width="220"
                                                            Height="220"
                                                            Progress="0.87"
                                                            RingBrush="#4BD786"
                                                            TrackBrush="#26302D"
                                                            Thickness="5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />

                                        <TextBlock Text="52:18"
                                                   FontFamily="Bahnschrift SemiCondensed"
                                                   FontWeight="SemiBold"
                                                   FontSize="58"
                                                   Foreground="#EDF3F2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-3,0,0" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Integrated chevron bridge -->
        <Grid Grid.Row="1" Panel.ZIndex="4">
            <Border Width="53"
                    Height="30"
                    CornerRadius="0,0,11,11"
                    Background="#33393C"
                    BorderBrush="#596166"
                    BorderThickness="1,0,1,1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <TextBlock Text="⌃"
                           FontFamily="Segoe UI Symbol"
                           FontSize="16"
                           Foreground="#9EA7A9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-2,0,0" />
            </Border>
        </Grid>

        <!-- Drawer -->
        <Border Grid.Row="2"
                Width="306"
                HorizontalAlignment="Center"
                CornerRadius="0,0,20,20"
                Background="{StaticResource DrawerBrush}"
                BorderBrush="#565F63"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="17" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid Margin="13,17,13,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                    <Button Style="{StaticResource IncrementButtonStyle}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="+5" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="MIN" FontSize="8" Foreground="#AAB5B7" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IncrementButtonStyle}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="+10" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="MIN" FontSize="8" Foreground="#AAB5B7" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IncrementButtonStyle}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="+30" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="MIN" FontSize="8" Foreground="#AAB5B7" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IncrementButtonStyle}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="+60" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="MIN" FontSize="8" Foreground="#AAB5B7" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="↻" HorizontalAlignment="Center" ToolTip="Reset" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="Ⅱ" HorizontalAlignment="Center" ToolTip="Pausar" />
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="•••" HorizontalAlignment="Center" ToolTip="Mais" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
