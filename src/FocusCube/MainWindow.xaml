<Window x:Class="FocusCube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCube.Controls"
        Title="Focus Cube"
        Width="170"
        Height="251"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <RadialGradientBrush x:Key="DisplaySurfaceBrush"
                             Center="0.50,0.35"
                             GradientOrigin="0.50,0.28"
                             RadiusX="0.72"
                             RadiusY="0.82">
            <GradientStop Color="#242528" Offset="0" />
            <GradientStop Color="#161719" Offset="0.42" />
            <GradientStop Color="#0A0B0C" Offset="0.82" />
            <GradientStop Color="#050607" Offset="1" />
        </RadialGradientBrush>

        <!-- Exact hit regions are aligned to the approved reference artwork.
             Hover feedback is deliberately subtle so it never draws an offset blue box. -->
        <Style x:Key="ReferenceHitButton" TargetType="Button">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="44">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitChrome" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitChrome" Property="Background" Value="#25000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleHitButton" TargetType="Button">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The Viewbox always keeps the approved 170 × 251 design scale.
         Compact mode clips the lower drawer instead of scaling the artwork. -->
    <Grid x:Name="ViewportClip" ClipToBounds="True" Background="Transparent">
        <Viewbox x:Name="DesignView"
                 Width="170"
                 Height="251"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Stretch="Fill"
                 StretchDirection="Both">
            <Canvas Width="1388" Height="2048" Background="Transparent">

                <!-- Drawer is a separate physical layer so it can slide upward behind the body. -->
                <Canvas x:Name="DrawerLayer"
                        Width="1388"
                        Height="2048"
                        Panel.ZIndex="0">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="DrawerTranslate" Y="0" />
                    </Canvas.RenderTransform>

                    <Image Canvas.Left="0"
                           Canvas.Top="0"
                           Width="1388"
                           Height="2048"
                           Source="Assets/widget-shell-reference.png"
                           Stretch="Fill"
                           SnapsToDevicePixels="True">
                        <Image.Clip>
                            <RectangleGeometry Rect="104,1274,1178,724" RadiusX="72" RadiusY="72" />
                        </Image.Clip>
                        <Image.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="32"
                                              ShadowDepth="18"
                                              Direction="270"
                                              Opacity="0.42" />
                        </Image.Effect>
                    </Image>

                    <!-- Exact physical button bounds measured from the approved reference. -->
                    <Button Canvas.Left="229" Canvas.Top="1429" Width="206" Height="205"
                            Style="{StaticResource ReferenceHitButton}"
                            ToolTip="Adicionar 5 minutos"
                            Click="Add5_Click" />
                    <Button Canvas.Left="468" Canvas.Top="1429" Width="206" Height="205"
                            Style="{StaticResource ReferenceHitButton}"
                            ToolTip="Adicionar 10 minutos"
                            Click="Add10_Click" />
                    <Button Canvas.Left="707" Canvas.Top="1429" Width="206" Height="205"
                            Style="{StaticResource ReferenceHitButton}"
                            ToolTip="Adicionar 30 minutos"
                            Click="Add30_Click" />
                    <Button Canvas.Left="946" Canvas.Top="1429" Width="207" Height="205"
                            Style="{StaticResource ReferenceHitButton}"
                            ToolTip="Adicionar 60 minutos"
                            Click="Add60_Click" />

                    <!-- Reset and more are glyphs printed on the drawer, so their hit areas stay invisible. -->
                    <Button Canvas.Left="350" Canvas.Top="1660" Width="200" Height="210"
                            Style="{StaticResource InvisibleHitButton}"
                            ToolTip="Reset"
                            Click="Reset_Click" />

                    <Button x:Name="PauseButton"
                            Canvas.Left="588" Canvas.Top="1667" Width="206" Height="205"
                            Style="{StaticResource ReferenceHitButton}"
                            ToolTip="Pausar"
                            Click="Pause_Click" />

                    <Button x:Name="MoreButton"
                            Canvas.Left="835" Canvas.Top="1660" Width="200" Height="210"
                            Style="{StaticResource InvisibleHitButton}"
                            ToolTip="Mais opções"
                            Click="More_Click" />

                    <!-- The static pause glyph was removed from the shell bitmap.
                         These vector glyphs change state without lowering image fidelity. -->
                    <Path x:Name="PauseGlyph"
                          Data="M 661,1724 L 661,1805 M 709,1724 L 709,1805"
                          Stroke="#82E9F2"
                          StrokeThickness="20"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          IsHitTestVisible="False" />

                    <Path x:Name="PlayGlyph"
                          Data="M 655,1718 L 728,1764 L 655,1810 Z"
                          Fill="#82E9F2"
                          Visibility="Collapsed"
                          IsHitTestVisible="False" />
                </Canvas>

                <!-- Main body stays above the drawer while it retracts. -->
                <Canvas x:Name="MainLayer"
                        Width="1388"
                        Height="2048"
                        Panel.ZIndex="2">
                    <Image Canvas.Left="0"
                           Canvas.Top="0"
                           Width="1388"
                           Height="2048"
                           Source="Assets/widget-shell-reference.png"
                           Stretch="Fill"
                           SnapsToDevicePixels="True">
                        <Image.Clip>
                            <RectangleGeometry Rect="34,8,1320,1368" RadiusX="92" RadiusY="92" />
                        </Image.Clip>
                        <Image.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="32"
                                              ShadowDepth="18"
                                              Direction="270"
                                              Opacity="0.42" />
                        </Image.Effect>
                    </Image>

                    <Border Canvas.Left="101"
                            Canvas.Top="74"
                            Width="1186"
                            Height="1238"
                            CornerRadius="76"
                            Background="{StaticResource DisplaySurfaceBrush}"
                            BorderBrush="#383B3D"
                            BorderThickness="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="22"
                                              ShadowDepth="9"
                                              Direction="315"
                                              Opacity="0.52" />
                        </Border.Effect>
                    </Border>

                    <Border Canvas.Left="116"
                            Canvas.Top="89"
                            Width="1156"
                            Height="1208"
                            CornerRadius="66"
                            Background="Transparent"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="5"
                            IsHitTestVisible="False" />

                    <Border x:Name="CompletionGlow"
                            Canvas.Left="101"
                            Canvas.Top="74"
                            Width="1186"
                            Height="1238"
                            CornerRadius="76"
                            Background="Transparent"
                            BorderBrush="#FFFF4438"
                            BorderThickness="15"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <local:ProgressRing x:Name="TimerProgressRing"
                                        Canvas.Left="211"
                                        Canvas.Top="166"
                                        Width="966"
                                        Height="966"
                                        Progress="1"
                                        TrackBrush="#404347"
                                        RingBrush="#55DB8C"
                                        Thickness="29"
                                        SegmentCount="12"
                                        GapDegrees="6.5"
                                        UseProgressColor="True"
                                        IsHitTestVisible="False" />

                    <TextBlock x:Name="ModeText"
                               Canvas.Left="0"
                               Canvas.Top="425"
                               Width="1388"
                               Text="TIMER"
                               TextAlignment="Center"
                               FontFamily="Segoe UI Light"
                               FontSize="50"
                               FontWeight="Light"
                               Foreground="#AEB3B8"
                               IsHitTestVisible="False" />

                    <TextBlock x:Name="TimeText"
                               Canvas.Left="0"
                               Canvas.Top="532"
                               Width="1388"
                               Text="60:00"
                               TextAlignment="Center"
                               FontFamily="Segoe UI Light"
                               FontSize="186"
                               FontWeight="Light"
                               Foreground="#EFF8FA"
                               IsHitTestVisible="False" />

                    <Path x:Name="DrawerChevron"
                          Data="M 651,1272 L 694,1228 L 737,1272"
                          Stroke="#D8DEE1"
                          StrokeThickness="12"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          IsHitTestVisible="False" />

                    <Button Canvas.Left="590"
                            Canvas.Top="1170"
                            Width="210"
                            Height="170"
                            Style="{StaticResource InvisibleHitButton}"
                            ToolTip="Recolher controles"
                            Click="DrawerToggle_Click" />
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
