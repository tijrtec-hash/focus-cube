<Window x:Class="FocusCube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCube.Controls"
        Title="Focus Cube"
        Width="170"
        Height="251"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <RadialGradientBrush x:Key="DisplaySurfaceBrush"
                             Center="0.50,0.35"
                             GradientOrigin="0.50,0.28"
                             RadiusX="0.72"
                             RadiusY="0.82">
            <GradientStop Color="#242528" Offset="0" />
            <GradientStop Color="#161719" Offset="0.42" />
            <GradientStop Color="#0A0B0C" Offset="0.82" />
            <GradientStop Color="#050607" Offset="1" />
        </RadialGradientBrush>

        <!-- Resting artwork comes from the approved visual reference. These buttons
             preserve real hit targets without replacing the approved physical relief. -->
        <Style x:Key="ReferenceHitButton" TargetType="Button">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="34">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitChrome" Property="BorderBrush" Value="#6085F2E8" />
                                <Setter TargetName="HitChrome" Property="BorderThickness" Value="5" />
                                <Setter TargetName="HitChrome" Property="Background" Value="#0D8EF5EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitChrome" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleHitButton" TargetType="Button">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The Viewbox deliberately stays at the approved 170 × 251 size even when
         the Window collapses. The root clips the lower drawer instead of squashing it. -->
    <Grid x:Name="ViewportClip" ClipToBounds="True" Background="Transparent">
        <Viewbox x:Name="DesignView"
                 Width="170"
                 Height="251"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Stretch="Fill"
                 StretchDirection="Both">
            <Canvas Width="1388" Height="2048" Background="Transparent">

                <Image Canvas.Left="0"
                       Canvas.Top="0"
                       Width="1388"
                       Height="2048"
                       Source="Assets/widget-shell-reference.png"
                       Stretch="Fill"
                       SnapsToDevicePixels="True">
                    <Image.Clip>
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="34,8,1320,1368" RadiusX="92" RadiusY="92" />
                            <RectangleGeometry Rect="104,1274,1178,724" RadiusX="72" RadiusY="72" />
                        </GeometryGroup>
                    </Image.Clip>
                    <Image.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="32"
                                          ShadowDepth="18"
                                          Direction="270"
                                          Opacity="0.42" />
                    </Image.Effect>
                </Image>

                <Border Canvas.Left="101"
                        Canvas.Top="74"
                        Width="1186"
                        Height="1238"
                        CornerRadius="76"
                        Background="{StaticResource DisplaySurfaceBrush}"
                        BorderBrush="#383B3D"
                        BorderThickness="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="22"
                                          ShadowDepth="9"
                                          Direction="315"
                                          Opacity="0.52" />
                    </Border.Effect>
                </Border>

                <Border Canvas.Left="116"
                        Canvas.Top="89"
                        Width="1156"
                        Height="1208"
                        CornerRadius="66"
                        Background="Transparent"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="5"
                        IsHitTestVisible="False" />

                <Border x:Name="CompletionGlow"
                        Canvas.Left="101"
                        Canvas.Top="74"
                        Width="1186"
                        Height="1238"
                        CornerRadius="76"
                        Background="Transparent"
                        BorderBrush="#FFFF4438"
                        BorderThickness="15"
                        Opacity="0"
                        IsHitTestVisible="False" />

                <local:ProgressRing x:Name="TimerProgressRing"
                                    Canvas.Left="211"
                                    Canvas.Top="166"
                                    Width="966"
                                    Height="966"
                                    Progress="1"
                                    TrackBrush="#404347"
                                    RingBrush="#55DB8C"
                                    Thickness="29"
                                    SegmentCount="12"
                                    GapDegrees="6.5"
                                    UseProgressColor="True"
                                    IsHitTestVisible="False" />

                <TextBlock x:Name="ModeText"
                           Canvas.Left="0"
                           Canvas.Top="425"
                           Width="1388"
                           Text="TIMER"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Light"
                           FontSize="50"
                           FontWeight="Light"
                           Foreground="#AEB3B8"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="TimeText"
                           Canvas.Left="0"
                           Canvas.Top="532"
                           Width="1388"
                           Text="60:00"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Light"
                           FontSize="186"
                           FontWeight="Light"
                           Foreground="#EFF8FA"
                           IsHitTestVisible="False" />

                <Path x:Name="DrawerChevron"
                      Data="M 651,1272 L 694,1228 L 737,1272"
                      Stroke="#D8DEE1"
                      StrokeThickness="12"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      IsHitTestVisible="False" />

                <Button Canvas.Left="590"
                        Canvas.Top="1170"
                        Width="210"
                        Height="170"
                        Style="{StaticResource InvisibleHitButton}"
                        ToolTip="Recolher controles"
                        Click="DrawerToggle_Click" />

                <Button Canvas.Left="198" Canvas.Top="1430" Width="132" Height="142"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Adicionar 5 minutos"
                        Click="Add5_Click" />
                <Button Canvas.Left="358" Canvas.Top="1430" Width="150" Height="142"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Adicionar 10 minutos"
                        Click="Add10_Click" />
                <Button Canvas.Left="534" Canvas.Top="1430" Width="150" Height="142"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Adicionar 30 minutos"
                        Click="Add30_Click" />
                <Button Canvas.Left="713" Canvas.Top="1430" Width="150" Height="142"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Adicionar 60 minutos"
                        Click="Add60_Click" />

                <Button Canvas.Left="292" Canvas.Top="1685" Width="110" Height="135"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Reset"
                        Click="Reset_Click" />
                <Button x:Name="PauseButton" Canvas.Left="591" Canvas.Top="1666" Width="206" Height="185"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Pausar"
                        Click="Pause_Click" />
                <Button x:Name="MoreButton" Canvas.Left="888" Canvas.Top="1686" Width="130" Height="135"
                        Style="{StaticResource ReferenceHitButton}" ToolTip="Mais opções"
                        Click="More_Click" />
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
